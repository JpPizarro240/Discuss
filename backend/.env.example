# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_NAME=cinedebate

# JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=2h

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8100
