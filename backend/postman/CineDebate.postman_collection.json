              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pm_{{rnd}}\",\n  \"email\": \"pm_{{rnd}}@test.cl\",\n  \"password\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('rnd', Date.now().toString().slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 - usuario creado con rol user', function () { pm.response.to.have.status(201); const u = pm.response.json().user; pm.expect(u.role).to.eql('user'); pm.expect(u).to.not.have.property('password_hash'); });"
                ]
              }
            }
          ]
        },
