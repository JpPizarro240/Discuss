{
  "info": {
    "name": "CineDebate API",
    "description": "Pruebas de la API REST de CineDebate. Ejecutar con 'Run collection' (carpetas Health, Autenticación y Títulos). La carpeta 'Solo administrador' requiere promover al usuario a admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 - servidor y BD conectados', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().database).to.eql('connected'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
